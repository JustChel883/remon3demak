<Window x:Class="remon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список товаров - ООО РемонтМаркет" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SecondaryBg}" Padding="10">
            <DockPanel LastChildFill="False">
                <Image Source="logo.png" Height="40" DockPanel.Dock="Left"/>
                <TextBlock Text="ООО РемонтМаркет" FontSize="22" FontWeight="Bold" 
                           Foreground="White" VerticalAlignment="Center" Margin="15,0,0,0" DockPanel.Dock="Left"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UserFioTb" FontSize="16" FontWeight="SemiBold" 
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button x:Name="OrdersBtn" Content="Заказы" Click="OrdersBtn_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
                    <Button Content="Назад (Выйти)" Click="LogoutBtn_Click" Background="{StaticResource AccentColor}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" x:Name="FilterPanel" Padding="10" Background="#F0F0F0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="SearchTb" Width="200" TextChanged="SearchTb_TextChanged" Margin="0,0,15,0"/>
                <TextBlock Text="Производитель:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="ManufacturerCb" Width="150" SelectionChanged="ManufacturerCb_SelectionChanged" Margin="0,0,15,0"/>
                <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="SortCb" Width="150" SelectionChanged="SortCb_SelectionChanged">
                    <ComboBoxItem Content="По умолчанию" IsSelected="True"/>
                    <ComboBoxItem Content="Кол-во (возр.)"/>
                    <ComboBoxItem Content="Кол-во (убыв.)"/>
                    <ComboBoxItem Content="Цена (возр.)"/>
                    <ComboBoxItem Content="Цена (убыв.)"/>
                    <ComboBoxItem Content="Скидка (возр.)"/>
                    <ComboBoxItem Content="Скидка (убыв.)"/>
                </ComboBox>
                <Button x:Name="AddProductBtn" Content="Добавить товар" Margin="20,0,0,0" 
                        Click="AddProductBtn_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="10">
            <ItemsControl x:Name="ProductsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,10" Padding="10" 
                                Cursor="Hand" MouseLeftButtonUp="Product_MouseLeftButtonUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHighDiscount}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DiscountBg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Quantity}" Value="0">
                                            <Setter Property="Background" Value="LightBlue"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" Width="100" Height="100">
                                    <Image Source="{Binding Image}" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="15,0,10,0">
                                    <TextBlock FontSize="16" FontWeight="Bold">
                                        <Run Text="{Binding Category}"/> | <Run Text="{Binding Name}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description, StringFormat='Описание: {0}'}" TextWrapping="Wrap" Margin="0,5"/>
                                    <TextBlock Text="{Binding Manufacturer, StringFormat='Производитель: {0}'}"/>
                                    <TextBlock Text="{Binding Supplier, StringFormat='Поставщик: {0}'}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="Цена: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding OldPriceText}" Foreground="Red" TextDecorations="Strikethrough"
                                                   Visibility="{Binding OldPriceVisibility}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding FinalPriceText}" Foreground="Black" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Unit, StringFormat='Единица измерения: {0}'}"/>
                                    <TextBlock Text="{Binding Quantity, StringFormat='Количество на складе: {0}'}"/>
                                </StackPanel>
                                <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1" Padding="5" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DiscountText}" TextAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <Button Grid.Column="3" Content="Удалить" Background="#E74C3C" 
                                        VerticalAlignment="Center" Margin="10,0,0,0"
                                        Click="DeleteBtn_Click" Tag="{Binding Id}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanDelete}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>