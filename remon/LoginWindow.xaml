<Window x:Class="remon.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация - ООО РемонтМаркет" Height="400" Width="350"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="20">
           
            <Image Source="logo.png" Height="80" Margin="0,0,0,20"/>
            <TextBlock Text="Вход в систему" FontSize="20" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="{StaticResource AccentColor}"/>

            <TextBlock Text="Логин:"/>
            <TextBox x:Name="LoginTb" />

            <TextBlock Text="Пароль:" Margin="0,10,0,0"/>
            <PasswordBox x:Name="PasswordPb" />

            <Button x:Name="LoginBtn" Content="Войти" Margin="0,10,0,10" Click="LoginBtn_Click"/>
            <Button x:Name="GuestBtn" Content="Войти как гость" Click="GuestBtn_Click" Height="24" Width="309"/>
        </StackPanel>
    </Grid>
</Window>