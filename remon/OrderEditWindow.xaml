<Window x:Class="remon.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ" Height="560" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock x:Name="IdLabel" Text="ID заказа:" FontWeight="Bold"/>
            <TextBox x:Name="IdTb" IsReadOnly="True" Background="#F0F0F0" Margin="0,5,0,15"/>

            <TextBlock Text="Артикул (несколько через запятую):" FontWeight="Bold"/>
            <TextBox x:Name="ArticleTb" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,5,0,15"/>

            <TextBlock Text="Статус заказа:" FontWeight="Bold"/>
            <ComboBox x:Name="StatusCb" DisplayMemberPath="Name" Margin="0,5,0,15"/>

            <TextBlock Text="Адрес пункта выдачи:" FontWeight="Bold"/>
            <ComboBox x:Name="PickupCb" DisplayMemberPath="Address" Margin="0,5,0,15"/>

            <TextBlock Text="Дата заказа:" FontWeight="Bold"/>
            <DatePicker x:Name="RequestDatePicker" Margin="0,5,0,15"/>

            <TextBlock Text="Дата выдачи:" FontWeight="Bold"/>
            <DatePicker x:Name="DeliveryDatePicker" Margin="0,5,0,25"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Click="SaveBtn_Click" Padding="15,5" Margin="0,0,10,0"
                        Background="#2ECC71" Foreground="White"/>
                <Button Content="Назад" Click="BackBtn_Click" Padding="15,5"
                        Background="#95A5A6" Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>